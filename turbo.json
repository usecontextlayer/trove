{
	"$schema": "https://turbo.build/schema.json",
	// `TROVE*` is Trove's own env scheme (the registry origin, the CLI's dev
	// overrides). `CLOUDFLARE*` are wrangler's own variables and keep their
	// upstream names — they must REACH a task (deploying the registry needs
	// them) even though the publish path deliberately unsets them before an
	// anonymous deploy. Passthrough, not `env`: these are runtime-only and must
	// not invalidate the build/test cache.
	"globalPassThroughEnv": ["TROVE*", "CLOUDFLARE*"],
	"tasks": {
		"//#format.verify": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"dev:watch": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:integration:node": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"tsc": {
			"dependsOn": ["^build", "^tsc"],
			"outputs": []
		}
	}
}
