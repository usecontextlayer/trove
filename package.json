{
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^24.13.3",
		"tsdown": "latest",
		"tsx": "latest",
		"turbo": "2.10.5",
		"typescript": "^6",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"name": "trove",
	"packageManager": "pnpm@10.34.4",
	"private": true,
	"scripts": {
		"build": "npx turbo run build",
		"check": "pnpm run format.fix && pnpm run tsc",
		"clean": "npx turbo run clean && rm -rf node_modules .turbo",
		"format": "pnpm run format.fix",
		"format.fix": "./node_modules/.bin/biome check --fix --error-on-warnings .",
		"format.verify": "./node_modules/.bin/biome check --error-on-warnings .",
		"ncu": "npx npm-check-updates --workspaces --root",
		"test": "npx turbo run test",
		"test:integration": "npx turbo run test:integration:node",
		"test:integration:node": "npx turbo run test:integration:node",
		"tsc": "npx turbo run tsc"
	},
	"type": "module",
	"workspaces": [
		"packages/*"
	]
}
