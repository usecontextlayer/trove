{
	"$schema": "./node_modules/wrangler/config-schema.json",

	"assets": {
		"binding": "ASSETS",
		"directory": "./public/",

		// The platform serves its landing page at "/", so index.html must resolve
		// there — "none" would require the exact file path and 404 the root. This
		// is the same handling artifacts get from their host (the /index.html →
		// / 307 included).
		"html_handling": "auto-trailing-slash",

		// MUST stay "none". Anything else, combined with the run_worker_first
		// array, makes the asset worker claim every unmatched path and the Worker
		// never sees a 404 (has_static_routing in asset-worker/src/handler.ts).
		"not_found_handling": "none",

		// Array form (wrangler >= 4.20.0): ONLY these paths invoke the Worker;
		// everything else (/trove.js, /AGENTS.md, /skills/**) stays on the free,
		// unmetered asset path and is never subject to the free-plan request cap.
		// Never replace this with `true` — boolean form meters every asset request.
		"run_worker_first": ["/register", "/a/*"]
	},
	"compatibility_date": "2026-08-01",

	"d1_databases": [
		{
			"binding": "DB",
			// The real database in the production account (803 Inc), created
			// 2026-08-10 via `wrangler d1 create trove-registry`. Local dev and
			// tests key off this string but never talk to remote D1.
			"database_id": "80f3840f-93b7-4b80-a738-2ba6d88e562a",
			"database_name": "trove-registry",
			"migrations_dir": "database/migrations"
		}
	],
	"main": "src/index.ts",
	"name": "trove-registry",

	"observability": { "enabled": true },

	"routes": [{ "custom_domain": true, "pattern": "trove.usecontextlayer.com" }]
}
